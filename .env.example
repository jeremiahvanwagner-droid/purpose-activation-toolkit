# ---------------------------------------------------------------------------
# Supabase — REQUIRED in production.
#
# These are inlined into the client bundle at BUILD time, so setting them in
# Vercel is not enough on its own: you must redeploy afterwards or the build
# ships with empty strings. When they are missing, lib/supabase.ts returns null,
# lib/entitlements.ts fails closed to "signed-out", and every paying customer is
# locked out of the modules they bought. (This is exactly what happened on
# 2026-07-22 — the previous version of this file said "leave blank for now".)
#
# Umbrella project: aagqvfwuixpxtdcrdxmv
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public download URL for the free eBook gifted on audit completion.
# Hosted in the public `project-assets` bucket on the Umbrella project.
# Client-visible on purpose — the book is a free gift, not gated content.
NEXT_PUBLIC_EBOOK_URL=

# Meta Pixel. OPTIONAL — lib/metaPixel.ts defaults to the live "Truth J Blue"
# dataset (815130848255492), so leaving this unset is the correct production
# setting. Unlike Supabase above, a missing value here costs you nothing.
# Set it only to point a preview build at a throwaway dataset so test traffic
# doesn't pollute the real audience. Inlined at BUILD time — redeploy to change.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — server-side Purchase reporting. Used by
# app/api/ghl/order-webhook/route.ts (store) and lib/eosMeasurement.ts (EOS).
# The store's checkout finishes on HighLevel's domain, so the browser pixel
# never sees a sale; without this token no Purchase is ever reported.
# Events Manager -> Settings -> Conversions API -> Generate access token.
META_CAPI_ACCESS_TOKEN=

# Shared secret the HighLevel "Custom Webhook" action must present, as the
# x-tjb-webhook-secret header (or top-level body field "secret"). Any long
# random string; the same value goes in both places. Unset = route returns 503.
GHL_ORDER_WEBHOOK_SECRET=

# Set ONLY while validating in Events Manager -> Test Events. With it present,
# Meta routes events to that tab instead of counting them. Remove after.
META_TEST_EVENT_CODE=

# ---------------------------------------------------------------------------
# SERVER-ONLY — used by app/api/audit-complete/route.ts.
# Never prefix these with NEXT_PUBLIC_; that would ship them to the browser.
# ---------------------------------------------------------------------------

# Bypasses RLS to write public.audit_leads. Umbrella project.
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel — Truth J Blue location. The upsert here tags the lead
# `audit-completed`, which is what fires the delivery workflow that emails the
# book. Sending stays on TJB's warm GHL sender, so no new SPF/DKIM is needed.
GHL_LOCATION_ID_TJB=
GHL_PRIVATE_INTEGRATION_TOKEN_TJB=
